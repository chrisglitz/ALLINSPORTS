# Database
DATABASE_URL="postgresql://user:password@localhost:5432/allinsports?schema=public"

# Redis (optional - caching disabled if not set)
REDIS_URL="redis://localhost:6379"

# Data Provider Configuration
USE_MOCK_DATA=true

# Real Provider API Keys (when USE_MOCK_DATA=false)
# SCHEDULE_API_KEY=
# STATS_API_KEY=
# INJURIES_API_KEY=
# ODDS_API_KEY=
# WEATHER_API_KEY=
# NEWS_API_KEY=

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
